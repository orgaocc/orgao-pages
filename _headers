# Catch-all baseline (HTML, etc) — short cache, sempre revalida
/*
  Cache-Control: public, max-age=300, must-revalidate

# CSS / JS — 7 dias
/jpe/cc-v3/css/*
  Cache-Control: public, max-age=604800

/jpe/cc-v3/js/*
  Cache-Control: public, max-age=604800

/jpe/cc-v7/css/*
  Cache-Control: public, max-age=604800

/jpe/cc-v7/js/*
  Cache-Control: public, max-age=604800

/jpe/cc-v9/css/*
  Cache-Control: public, max-age=604800

/jpe/cc-v9/js/*
  Cache-Control: public, max-age=604800

# JS compartilhado — 7 dias
/jpe/shared/*
  Cache-Control: public, max-age=604800

# Imagens (webp/jpg/png) — 30 dias
/jpe/cc-v3/assets/*
  Cache-Control: public, max-age=2592000

/jpe/cc-v7/assets/*
  Cache-Control: public, max-age=2592000

/jpe/cc-v9/assets/*
  Cache-Control: public, max-age=2592000

# Fontes — 1 ano + immutable (não mudam pra mesma URL)
/jpe/cc-v3/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/jpe/cc-v7/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/jpe/cc-v9/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
