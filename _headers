# Catch-all baseline (HTML, etc) — short cache, sempre revalida
/*
  Cache-Control: public, max-age=300, must-revalidate

# CSS / JS — 7 dias
/v3/css/*
  Cache-Control: public, max-age=604800

/v3/js/*
  Cache-Control: public, max-age=604800

/v7/css/*
  Cache-Control: public, max-age=604800

/v7/js/*
  Cache-Control: public, max-age=604800

# Imagens (webp/jpg/png) — 30 dias
/v3/assets/*
  Cache-Control: public, max-age=2592000

/v7/assets/*
  Cache-Control: public, max-age=2592000

# Fontes — 1 ano + immutable (não mudam pra mesma URL)
/v3/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
